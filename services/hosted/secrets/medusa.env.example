NODE_ENV=production
BUILDKART_ENVIRONMENT=staging
PAYMENT_ADAPTER_MODE=simulated
DATABASE_URL=postgres://<user>:<password>@postgres:5432/buildkart
REDIS_URL=redis://:<password>@redis:6379
JWT_SECRET=<staging-random-secret>
COOKIE_SECRET=<staging-random-secret>
STORE_CORS=https://api-staging.example.invalid
ADMIN_CORS=https://ops-staging.example.invalid
VENDOR_CORS=https://ops-staging.example.invalid
AUTH_CORS=https://ops-staging.example.invalid
FILE_BACKEND_URL=https://ops-staging.example.invalid/static
MERCUR_VENDOR_URL=https://ops-staging.example.invalid/seller
STOREFRONT_REVALIDATE_URL=<disabled-or-staging-url>
STOREFRONT_REVALIDATE_SECRET=<staging-random-secret>
CMS_BASE_URL=http://cms:1337
CMS_INTERNAL_KEY=<same-value-as-cms-env>
# Map Medusa auth actor IDs to one or more roles: operations_admin, merchandiser,
# merchandising_approver, auditor. Missing or malformed assignments fail closed.
BUILDKART_ADMIN_ROLE_ASSIGNMENTS_JSON=<secret-managed-json>
