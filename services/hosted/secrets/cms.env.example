NODE_ENV=production
BUILDKART_ENVIRONMENT=staging
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://ops-staging.example.invalid/cms
IS_PROXIED=true
APP_KEYS=<comma-separated-random-keys>
API_TOKEN_SALT=<staging-random-secret>
ADMIN_JWT_SECRET=<staging-random-secret>
TRANSFER_TOKEN_SALT=<staging-random-secret>
JWT_SECRET=<staging-random-secret>
ENCRYPTION_KEY=<staging-random-secret>
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=buildkart_cms
DATABASE_USERNAME=<same-as-postgres-env-user>
DATABASE_PASSWORD=<same-as-postgres-env-password>
DATABASE_SSL=false
CMS_INTERNAL_KEY=<same-value-as-medusa-env>
CMS_WEBHOOK_SECRET=<staging-random-secret>
