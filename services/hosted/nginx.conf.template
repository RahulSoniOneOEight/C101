worker_processes auto;

events { worker_connections 2048; }

http {
  log_format structured escape=json '{"time":"$time_iso8601","request_id":"$request_id",'
    '"host":"$host","method":"$request_method","uri":"$uri","status":$status,'
    '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';
  access_log /dev/stdout structured;
  error_log /dev/stderr warn;
  server_tokens off;
  map_hash_bucket_size 256;

  limit_req_zone $binary_remote_addr zone=pilot_api:10m rate=10r/s;
  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  # Origin lock for the operator host. Cloudflare adds X-Bazarbee-Edge for ops.gobazarbee.com; a
  # direct request to the origin with a spoofed Host header does not carry it and is rejected.
  map $host $edge_ops_host {
    default 0;
    "$PUBLIC_OPS_HOSTNAME" 1;
  }
  map $http_x_bazarbee_edge $edge_header {
    default 0;
    "$EDGE_SHARED_SECRET" 1;
  }
  map "$edge_ops_host$edge_header" $deny_ops_direct {
    default 0;
    "10" 1;
  }

  upstream experience_api { server experience-api:9020; }
  upstream medusa_api { server medusa-api:9010; }
  upstream tryton_api { server tryton:8000; }
  upstream web_app { server web:3000; }

  server {
    listen 8080 default_server;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Correlation-Id $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    # The operator host is only served to requests that came through Cloudflare.
    if ($deny_ops_direct = 1) {
      return 403;
    }

    # Unauthenticated gated requests go to the TOTP page. The login handler redirects an
    # unenrolled user onward to /ops/enroll.
    location @ops_login_redirect {
      return 302 https://$host/ops/login?next=$uri;
    }

    location @ops_denied {
      default_type text/plain;
      return 403 "Access denied. Contact a superadmin.";
    }

    # Internal auth_request target. Never exposed to browsers.
    location = /__ops_gate {
      internal;
      proxy_pass http://experience_api/v1/ops/gate;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
      proxy_set_header Cookie $http_cookie;
    }

    location = /health {
      proxy_pass http://experience_api/health;
    }

    # The storefront's magic-link landing page lives at /auth/email. Exact-match it before the
    # operator /auth/* block so the app host can serve it while Medusa auth stays ops-only.
    location = /auth/email {
      if ($host != $PUBLIC_APP_HOSTNAME) { return 404; }
      proxy_pass http://web_app;
    }

    # Admin console and Medusa admin API: require the BazarBee TOTP session.
    location ~ ^/(dashboard|admin)(/|$) {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      auth_request /__ops_gate;
      error_page 401 = @ops_login_redirect;
      error_page 403 423 = @ops_denied;
      proxy_pass http://medusa_api;
    }

    # Seller portal and shared auth/assets: Cloudflare Access only, no BazarBee TOTP.
    # Sellers stay on the Mercur seller login.
    location ~ ^/(seller|vendor|auth|static|uploads)(/|$) {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      proxy_pass http://medusa_api;
    }

    # Tryton ERP web client (SAO). Reachable ONLY on the operator hostname, under /erp/.
    # SAO posts to a relative /rpc/ path, so stripping the /erp/ prefix maps it onto
    # trytond's root JSON-RPC endpoint.
    location = /erp { return 301 /erp/; }
    location /erp/ {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      auth_request /__ops_gate;
      error_page 401 = @ops_login_redirect;
      error_page 403 423 = @ops_denied;
      # trytond scopes its session cookie to the database path (/<db>). Since the
      # client is served under /erp/, re-scope the cookie so the browser returns
      # it for /erp/<db>/ requests.
      proxy_cookie_path ~^/(.*)$ /erp/$1;
      proxy_pass http://tryton_api/;
    }

    # Ops identity pages and their API endpoints authenticate with the ops session. nginx must not
    # gate them, otherwise the login and TOTP endpoints could not be reached.
    location ^~ /ops/ {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      proxy_pass http://experience_api;
    }
    location = /ops {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      proxy_pass http://experience_api;
    }
    location ^~ /v1/ops/totp/ {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      proxy_pass http://experience_api;
    }
    location ^~ /v1/ops/staff {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      proxy_pass http://experience_api;
    }
    location = /v1/ops/gate {
      internal;
      proxy_pass http://experience_api/v1/ops/gate;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
    }

    # Operator/admin API, metrics and simulation controls: require the TOTP session.
    location ~ ^/v1/(admin|ops)(/|$) {
      if ($host = $PUBLIC_API_HOSTNAME) { return 404; }
      auth_request /__ops_gate;
      error_page 401 = @ops_login_redirect;
      error_page 403 423 = @ops_denied;
      proxy_pass http://experience_api;
    }
    location ~ ^/v1/payments/[^/]+/simulate$ {
      if ($host = $PUBLIC_API_HOSTNAME) { return 404; }
      auth_request /__ops_gate;
      error_page 401 = @ops_login_redirect;
      error_page 403 423 = @ops_denied;
      proxy_pass http://experience_api;
    }
    location ~ ^/v1/shipments/[^/]+/advance$ {
      if ($host = $PUBLIC_API_HOSTNAME) { return 404; }
      auth_request /__ops_gate;
      error_page 401 = @ops_login_redirect;
      error_page 403 423 = @ops_denied;
      proxy_pass http://experience_api;
    }
    location = /metrics {
      if ($host = $PUBLIC_API_HOSTNAME) { return 404; }
      auth_request /__ops_gate;
      error_page 401 = @ops_login_redirect;
      error_page 403 423 = @ops_denied;
      proxy_pass http://experience_api;
    }

    # Service-to-service webhook receiver. Strapi calls the Experience API directly on the private
    # Docker network; neither public hostname may forward this path.
    location ^~ /v1/internal/ { return 404; }

    # Catalogue imagery is served on the operator host but consumed cross-origin by the
    # Firebase-hosted storefront. The files are public product photos and the request carries no
    # credentials, so a wildcard origin is correct. Without this header CanvasKit cannot decode them
    # and every product card falls back to a placeholder.
    location ^~ /static/ {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      add_header Access-Control-Allow-Origin "*" always;
      add_header Cross-Origin-Resource-Policy "cross-origin" always;
      proxy_pass http://medusa_api;
    }

    location /v1/ {
      limit_req zone=pilot_api burst=30 nodelay;
      # Workspace streams stay open; ordinary API calls still have a bounded upstream.
      proxy_read_timeout 3600s;
      proxy_pass http://experience_api;
    }

    # Web storefront. Reachable ONLY on the app hostname. The customer (API) and operator hosts
    # keep 404 at / so neither can accidentally serve or cache the storefront.
    location / {
      if ($host != $PUBLIC_APP_HOSTNAME) { return 404; }
      proxy_pass http://web_app;
    }
  }
}
