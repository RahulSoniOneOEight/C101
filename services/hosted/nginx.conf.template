worker_processes auto;

events { worker_connections 2048; }

http {
  log_format structured escape=json '{"time":"$time_iso8601","request_id":"$request_id",'
    '"host":"$host","method":"$request_method","uri":"$uri","status":$status,'
    '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';
  access_log /dev/stdout structured;
  error_log /dev/stderr warn;
  server_tokens off;

  limit_req_zone $binary_remote_addr zone=pilot_api:10m rate=10r/s;

  upstream experience_api { server experience-api:9020; }
  upstream medusa_api { server medusa-api:9010; }
  upstream tryton_api { server tryton:8000; }

  server {
    listen 8080 default_server;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Correlation-Id $request_id;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    location = /health {
      proxy_pass http://experience_api/health;
    }

    # MVP admin/operator surfaces (Mercur admin + vendor panels and the Medusa admin/auth/vendor APIs).
    # Reachable ONLY on the operator hostname; the customer hostname 404s them.
    location ~ ^/(dashboard|seller|vendor|admin|auth|static|uploads)(/|$) {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      proxy_pass http://medusa_api;
    }

    # Tryton ERP web client (SAO). Reachable ONLY on the operator hostname, under /erp/.
    # SAO posts to a relative /rpc/ path, so stripping the /erp/ prefix maps it onto
    # trytond's root JSON-RPC endpoint.
    location = /erp { return 301 /erp/; }
    location /erp/ {
      if ($host != $PUBLIC_OPS_HOSTNAME) { return 404; }
      # trytond scopes its session cookie to the database path (/<db>). Since the
      # client is served under /erp/, re-scope the cookie so the browser returns
      # it for /erp/<db>/ requests.
      proxy_cookie_path ~^/(.*)$ /erp/$1;
      proxy_pass http://tryton_api/;
    }

    # The public customer hostname can never reach operator/admin/metrics or simulation controls.
    location ~ ^/(metrics|ops(?:/|$)|v1/(?:admin|ops)(?:/|$)|v1/payments/[^/]+/simulate$|v1/shipments/[^/]+/advance$) {
      if ($host = $PUBLIC_API_HOSTNAME) { return 404; }
      proxy_pass http://experience_api;
    }

    location /v1/ {
      limit_req zone=pilot_api burst=30 nodelay;
      proxy_pass http://experience_api;
    }

    location / { return 404; }
  }
}
