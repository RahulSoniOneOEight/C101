{
  "name": "buildkart-experience-api",
  "version": "0.2.0-draft",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:workers": "bun run src/workers/event-consumers.ts",
    "typecheck": "bunx tsc --noEmit",
    "test:concurrency": "bun run src/scripts/concurrency-test.ts",
    "test:expiry": "bun run src/scripts/expiry-test.ts",
    "test:nats": "bun run src/scripts/nats-check.ts",
    "test:consume": "bun run src/scripts/nats-consume.ts",
    "test:payment-flow": "bun run src/scripts/payment-flow-test.ts",
    "test:payment-matrix": "bun run src/scripts/payment-outcome-matrix-test.ts",
    "test:consumers": "bun run src/scripts/consumers-test.ts",
    "test:erp": "bun run src/scripts/erp-movement-test.ts",
    "test:reconciliation": "bun run src/scripts/reconciliation-test.ts",
    "test:connectivity": "bun run src/scripts/connectivity-test.ts",
    "test:isolation": "bun run src/scripts/isolation-test.ts",
    "test:identity": "bun run src/scripts/identity-test.ts",
    "test:rbac": "bun run src/scripts/rbac-test.ts",
    "test:rbac-http": "bun run src/scripts/rbac-http-test.ts",
    "test:acceptance": "bun run src/scripts/hosted-acceptance.ts",
    "test:notifications": "bun run src/scripts/notification-test.ts",
    "test:load": "bun run src/scripts/load-test.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "nats": "^2.29.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "1.2.9",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
