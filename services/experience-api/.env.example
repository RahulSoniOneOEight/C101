# BuildKart Experience API — example configuration (copy to .env).
PORT=9020
BUILDKART_ENVIRONMENT=staging
PAYMENT_ADAPTER_MODE=simulated

MEDUSA_BASE_URL=http://localhost:9010
MEDUSA_PUBLISHABLE_KEY=<publishable-key>
MEDUSA_REGION_ID=<region-id>
MEDUSA_COUNTRY_CODE=IN
TRYTON_BASE_URL=http://localhost:8010
TRYTON_DATABASE=buildkart_tryton
TRYTON_USERNAME=admin
TRYTON_PASSWORD=<staging-admin-password>
EXPERIENCE_DATABASE_URL=postgres://buildkart:buildkart@localhost:5433/buildkart_experience
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Load these two JSON values from the hosted secret manager; never commit tester identities.
PILOT_EXPECTED_USER_COUNT=20
PILOT_USERS_JSON=<secret-managed-json>
PILOT_ROLE_ASSIGNMENTS_JSON=<secret-managed-json>
PILOT_OTP_CODE=123456

# External delivery stays off until credentials, wording and tester consent are reviewed.
FIREBASE_PROJECT_ID=buildkart-staging
FCM_DELIVERY_ENABLED=false
PILOT_NOTIFICATION_TEMPLATES_APPROVED=false
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/buildkart-firebase-admin.json
