# BuildKart Experience API — example configuration (copy to .env).
PORT=9020
BUILDKART_ENVIRONMENT=staging
PAYMENT_ADAPTER_MODE=simulated

MEDUSA_BASE_URL=http://localhost:9010
MEDUSA_PUBLISHABLE_KEY=<publishable-key>
MEDUSA_REGION_ID=<region-id>
MEDUSA_COUNTRY_CODE=IN
TRYTON_BASE_URL=http://localhost:8010
TRYTON_DATABASE=buildkart_tryton
TRYTON_USERNAME=admin
TRYTON_PASSWORD=<staging-admin-password>
EXPERIENCE_DATABASE_URL=postgres://buildkart:buildkart@localhost:5433/buildkart_experience
