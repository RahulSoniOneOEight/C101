# BuildKart CMS (Strapi v5) — staging environment template.
# Copy to a secret-managed environment; never commit real values.
APP_KEYS=<comma-separated-random-keys>
API_TOKEN_SALT=<random>
ADMIN_JWT_SECRET=<random>
TRANSFER_TOKEN_SALT=<random>
JWT_SECRET=<random>
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=buildkart_cms
DATABASE_USERNAME=<staging-database-user>
DATABASE_PASSWORD=<staging-database-password>
# Webhook shared secret used by the Experience API content adapter.
CMS_WEBHOOK_SECRET=<staging-webhook-secret>
# Media storage (DAM authority pending approval).
MEDIA_PROVIDER=local
