# BuildKart CMS (Strapi v5) — staging environment template.
# Copy to a secret-managed environment; never commit real values.
APP_KEYS=<comma-separated-random-keys>
API_TOKEN_SALT=<random>
ADMIN_JWT_SECRET=<random>
TRANSFER_TOKEN_SALT=<random>
JWT_SECRET=<random>
ENCRYPTION_KEY=<random>
BUILDKART_ENVIRONMENT=staging
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://ops-staging.example.invalid/cms
IS_PROXIED=true
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=buildkart_cms
DATABASE_USERNAME=<same-as-postgres-env-user>
DATABASE_PASSWORD=<same-as-postgres-env-password>
# Shared only by Strapi and the server-side Medusa adapter. Never expose it to a browser.
CMS_INTERNAL_KEY=<staging-random-internal-key>
# Reserved for the future Experience API publish projection webhook.
CMS_WEBHOOK_SECRET=<staging-random-webhook-secret>
# Media storage (DAM authority pending approval).
MEDIA_PROVIDER=local
