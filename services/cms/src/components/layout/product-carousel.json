{
  "collectionName": "components_layout_product_carousels",
  "info": {
    "displayName": "Product carousel",
    "description": "Ordered product rail. Membership comes from staged ids or a curated collection; live price and stock are resolved by commerce."
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "tag": {
      "type": "string",
      "description": "Optional badge shown with the rail, for example Best Deals."
    },
    "productIds": { "type": "json" },
    "collection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::curated-collection.curated-collection"
    },
    "itemLimit": { "type": "integer", "default": 10, "min": 1, "max": 30 },
    "startsAt": { "type": "datetime" },
    "endsAt": { "type": "datetime" }
  }
}
