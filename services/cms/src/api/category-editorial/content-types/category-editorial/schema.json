{
  "kind": "collectionType",
  "collectionName": "category_editorials",
  "info": {
    "singularName": "category-editorial",
    "pluralName": "category-editorials",
    "displayName": "Category Editorial",
    "description": "Localized category heading, hero and guide content linked to a commerce category id."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "categoryId": { "type": "string", "required": true },
    "channel": {
      "type": "enumeration",
      "enum": ["b2c", "b2b"],
      "default": "b2c",
      "required": true,
      "description": "Channel this category presentation belongs to. B2C and B2B are independent sets."
    },
    "displayLabel": { "type": "string" },
    "shortText": { "type": "string" },
    "iconKey": {
      "type": "enumeration",
      "enum": [
        "bathroom-plumbing",
        "tiles-plywood",
        "electrical",
        "agriculture",
        "pumps-machines",
        "construction",
        "category"
      ],
      "default": "category"
    },
    "heading": { "type": "string", "required": true },
    "description": { "type": "text" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "heroAltText": { "type": "string" },
    "inspirationBlocks": { "type": "richtext" },
    "banners": {
      "type": "component",
      "repeatable": true,
      "component": "layout.category-banner",
      "description": "Promo banners shown on the category surface, ordered by priority."
    },
    "buyingGuides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq-article.faq-article"
    }
  }
}
