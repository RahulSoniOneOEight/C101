{
  "kind": "collectionType",
  "collectionName": "banners",
  "info": {
    "singularName": "banner",
    "pluralName": "banners",
    "displayName": "Banner",
    "description": "Editorial banner for a channel surface: home hero, campaign strip or category banner. The channel is carried by the placement type; there is no separate audience field. Editorial only."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "contentKey": { "type": "string", "required": true, "unique": true },
    "name": { "type": "string" },
    "categoryId": {
      "type": "string",
      "description": "Medusa category reference. Required for a category banner type; ignored by home types."
    },
    "placement": { "type": "string", "required": true },
    "title": { "type": "string", "required": true },
    "subtitle": { "type": "string" },
    "ctaLabel": { "type": "string" },
    "ctaTargetType": {
      "type": "enumeration",
      "enum": ["route", "product", "category", "collection", "url"],
      "default": "route"
    },
    "ctaTargetId": { "type": "string" },
    "imageMobile": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "imageTablet": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "imageDesktop": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "externalImageUrl": { "type": "string" },
    "imageAltText": { "type": "string" },
    "themeKey": {
      "type": "enumeration",
      "enum": ["primary", "trust", "promotion", "neutral"],
      "default": "primary"
    },
    "startsAt": { "type": "datetime" },
    "endsAt": { "type": "datetime" },
    "timezone": { "type": "string", "default": "Asia/Kolkata" },
    "priority": { "type": "integer", "default": 0 },
    "segments": { "type": "json" }
  }
}
