{
  "kind": "collectionType",
  "collectionName": "product_editorials",
  "info": {
    "singularName": "product-editorial",
    "pluralName": "product-editorials",
    "displayName": "Product Editorial",
    "description": "Editorial enrichment linked to a stable commerce product id. No price/stock/seller."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "medusaId": { "type": "string", "required": true, "unique": true },
    "subtitle": { "type": "string" },
    "descriptionBlocks": { "type": "richtext" },
    "editorialGallery": { "type": "media", "multiple": true, "allowedTypes": ["images", "videos"] },
    "buyingGuidance": { "type": "richtext" },
    "careAndSafety": { "type": "richtext" },
    "seoTitle": { "type": "string" },
    "seoDescription": { "type": "string" },
    "relatedArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq-article.faq-article"
    }
  }
}
